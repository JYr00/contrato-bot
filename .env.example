# Token del bot (créalo con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=

# API de Claude (https://console.anthropic.com): lee la foto de la cédula e interpreta mensajes con varios datos
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Datos de contacto del arrendador que aparecen en la cláusula de notificaciones
ARRENDADOR_CORREO=
ARRENDADOR_CELULAR=

# IDs de Telegram de quienes pueden crear contratos, separados por coma (ej. 123456789,987654321).
# Para conocer tu ID, escríbele al bot: si no estás autorizado, te lo responde.
USUARIOS_AUTORIZADOS=

# Catálogo: edificios, apartamentos, historial de contratos, arrendatarios y valores usados (para sugerirlos).
# Contiene datos personales: respáldalo y no lo subas al repositorio.
CATALOGO_PATH=data/catalogo.json

# Único chat que recibe el respaldo semanal y donde funciona /respaldo (tu ID de Telegram).
# Si se deja vacío, se usa el primer ID de USUARIOS_AUTORIZADOS.
RESPALDO_CHAT_ID=

# Chat que recibe los avisos de fallas (IA caída, contratos rechazados, errores).
# Si se deja vacío, se usa RESPALDO_CHAT_ID.
AVISOS_CHAT_ID=

# Opcional: ruta a LibreOffice si no está en el PATH (necesario para el PDF; sin él solo se envía el Word)
# Windows: SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=soffice

# Opcional: plantilla Word del contrato
PLANTILLA_PATH=templates/contrato-arrendamiento.docx
