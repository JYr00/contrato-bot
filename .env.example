# Token del bot (créalo con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=

# API de Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Datos de contacto del arrendador que aparecen en la cláusula de notificaciones
ARRENDADOR_CORREO=
ARRENDADOR_CELULAR=

# Opcional: chat de Telegram del arrendador para recibir copia de cada contrato generado.
# Para conocerlo, escríbele al bot y revisa los logs (se imprime el chat id).
ARRENDADOR_CHAT_ID=

# Opcional: ruta a LibreOffice si no está en el PATH (necesario para el PDF)
SOFFICE_PATH=soffice
